# --- Telegram ---
# Get this from @BotFather after creating your bot.
TELEGRAM_BOT_TOKEN=your-bot-token-here
# The channel/chat id the bot should listen to (Meera's private note channel).
# Negative, "-100..." prefixed = a channel/supergroup.
TELEGRAM_CHAT_ID=-1004461281816

# --- Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# --- Serper (Google News search, for the "current reference" step) ---
# https://serper.dev - free tier is enough for a few searches/day
SERPER_API_KEY=your-serper-api-key-here
